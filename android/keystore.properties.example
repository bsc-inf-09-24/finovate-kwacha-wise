# Template for local keystore and API configuration.
# Copy this file to 'keystore.properties' (in this same folder) and fill in your details.
# The 'keystore.properties' file is git-ignored and should never be committed.

# Keystore configuration
storeFile=absolute_path/to/keystore
keyAlias=kwachawise
keyPassword=CHANGE_ME

# Groq API Key must be added here
groq_api_key=[groq_api_key]
